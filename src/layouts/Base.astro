---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Seo, { type SeoProps } from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Player from '../components/Player.astro';
import JsonLd from '../components/JsonLd.astro';
import { organization } from '../lib/schema';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props extends SeoProps {
  schema?: unknown[];
}
const { schema = [], ...seo } = Astro.props;

// Content-Security-Policy for hosts that cannot send headers (GitHub Pages).
// frame-ancestors is only honoured as a real header: see public/_headers and README.
const csp = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: blob:",
  "font-src 'self'",
  "media-src 'self' blob:",
  "connect-src 'self' https://formspree.io",
  "form-action 'self' mailto: https://formspree.io",
  "base-uri 'self'",
  "object-src 'none'",
  'upgrade-insecure-requests',
].join('; ');
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />
    <Seo {...seo} />
    <JsonLd data={organization()} />
    {schema.map((s) => <JsonLd data={s} />)}
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <div class="cursor" aria-hidden="true" transition:persist="cursor"></div>
    <div class="cursor-dot" aria-hidden="true" transition:persist="cursor-dot"></div>
    <slot name="before-header" />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Player />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
