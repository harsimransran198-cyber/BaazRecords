---
/**
 * Play button for the bottom player (YouTube video or audio file). Renders nothing
 * when the track has neither yet, so the site never shows a button that does nothing.
 */
import Icon from './Icon.astro';
import { isPlayable, type ReleaseView, type Track } from '../lib/content';
import { playAttrs } from '../lib/play';

interface Props {
  track: Track;
  release: ReleaseView;
  variant?: 'round' | 'btn';
  text?: string;
  class?: string;
}
const { track, release, variant = 'round', text, class: cls } = Astro.props;
const label = `Play ${track.title} by ${release.byline}`;
---
{isPlayable(track) && (
  <button
    type="button"
    class:list={[variant === 'round' ? 'play-btn' : 'btn', cls]}
    aria-pressed="false"
    aria-label={variant === 'round' ? label : undefined}
    data-magnetic={variant === 'btn' ? '0.35' : '0.25'}
    data-cursor="Play"
    {...playAttrs(track, release)}
  >
    {variant === 'btn' ? (
      <span class="btn-label">
        <Icon name="play" class="i-play" />
        <Icon name="pause" class="i-pause" />
        <span data-label>{text ?? `Play ${track.title}`}</span>
      </span>
    ) : (
      <>
        <Icon name="play" class="i-play" />
        <Icon name="pause" class="i-pause" />
      </>
    )}
  </button>
)}
