---
import Logo from './Logo.astro';
import Menu from './Menu.astro';
import { getUpcomingEvents, formatEventDate } from '../lib/content';

const next = getUpcomingEvents()[0];
---
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <Logo href="/" />
  <div class="header-right">
    {next && (
      <a class="on-air mono no-underline" href={`/live/#${next.id}`} data-cursor="Tickets">
        <span class="rec-dot" aria-hidden="true"></span>
        <span>Next: {next.title} · {formatEventDate(next.date).replace(/^\w+, /, '')}</span>
      </a>
    )}
    <button class="eq-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="menu" data-magnetic="0.5">
      <span class="bars" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>
<Menu />
