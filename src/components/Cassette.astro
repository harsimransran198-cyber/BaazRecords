---
/** Cassette illustration — Uiverse by Praashoo7, recoloured. Reels spin while .playing is set. */
interface Props {
  title: string;
  side?: string;
  length?: string;
  id?: string;
}
const { title, side = 'Side A', length = 'C90', id } = Astro.props;
---
<div class="tape-stage" aria-hidden="true">
  <div class="tape-scale">
    <div class="cassette" id={id}>
      <div class="card">
        <div class="ups"><div class="screw1">+</div><div class="screw2">+</div></div>
        <div class="card1">
          <span class="tape-title">{title}</span>
          <div class="line1"></div>
          <div class="line2"></div>
          <div class="yl">
            <div class="roll"><div class="s_wheel"></div><div class="tape"></div><div class="e_wheel"></div></div>
            <p class="num">{length}</p>
          </div>
          <div class="or"><p class="time">{side}</p></div>
        </div>
        <div class="card2_main"><div class="card2"><div class="c1"></div><div class="t1"></div><div class="t2"></div><div class="c2"></div></div></div>
        <div class="downs"><div class="screw3">+</div><div class="screw4">+</div></div>
      </div>
    </div>
  </div>
</div>
