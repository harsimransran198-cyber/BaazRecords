---
/** Vinyl-spin release card: the record slides out of its sleeve and spins on hover. */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import PlayButton from './PlayButton.astro';
import { coverImage } from '../lib/media';
import { inkOn, isPlayable, type ReleaseView } from '../lib/content';
import { stageKeys } from '../lib/play';

interface Props {
  release: ReleaseView;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}
const { release: r, headingLevel = 'h3', eager = false } = Astro.props;
const H = headingLevel;
const cover = coverImage(r.cover, r.title);
const wide = !cover && Boolean(r.thumb);
const first = r.tracks.find(isPlayable);
---
<article class="beam tilt" data-tilt data-release-stage={stageKeys(r)} data-cursor="Open">
  <div class="r-card" style={`--c:${r.color};--on:${inkOn(r.color)}`}>
    <a href={r.url} class:list={['art', { wide }]} aria-hidden="true" tabindex="-1">
      <div class="disc-slot"><div class="vinyl"><div class="v-label">{r.thumb ? <img src={r.thumb} alt="" width="160" height="160" loading="lazy" referrerpolicy="no-referrer" /> : <span>{r.shortTitle ?? r.title}</span>}</div></div></div>
      <div class="cover">
        {cover ? (
          <Image src={cover} alt="" width={480} height={480} loading={eager ? 'eager' : 'lazy'} />
        ) : r.thumb ? (
          <img src={r.thumb} alt="" width="640" height="360" loading={eager ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer" />
        ) : (
          <div class="sleeve-art"><span class="mono">{r.catNo}</span><span class="stripe"></span><div class="b"><span class="t" style="font-size:clamp(1.4rem,2.6vw,2.2rem)">{r.shortTitle ?? r.title}</span></div></div>
        )}
      </div>
    </a>
    <div class="meta mono"><span>{r.catNo}</span><span>{[r.format, r.year].filter(Boolean).join(' // ')}</span></div>
    <div>
      <H><a href={r.url} class="no-underline">{r.title}</a></H>
      <p class="by">{r.byline}</p>
    </div>
    <div class="foot">
      <a href={r.url} class="link-arrow mono">Open record <Icon name="external" /></a>
      {first ? <PlayButton track={first} release={r} /> : <span class="soon">Preview soon</span>}
    </div>
  </div>
</article>
