---
/** Baaz Records wordmark: name + blinking REC lamp. */
interface Props {
  href?: string;
  suffix?: string;
}
const { href, suffix = 'home' } = Astro.props;
const Tag = href ? 'a' : 'span';
---
<Tag class="wordmark" href={href}>
  <span class="rec-dot" aria-hidden="true"></span>
  <span>Baaz</span>{' '}<small>Records</small>
  {href && suffix && <span class="sr-only">, {suffix}</span>}
</Tag>
