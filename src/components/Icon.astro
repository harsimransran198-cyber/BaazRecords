---
/** Inline SVG icons. Decorative by default (aria-hidden). */
interface Props {
  name: keyof typeof icons;
  class?: string;
}
const icons = {
  play: '<path fill="currentColor" d="M8 5v14l11-7z"/>',
  pause: '<path fill="currentColor" d="M7 5h4v14H7zM13 5h4v14h-4z"/>',
  external:
