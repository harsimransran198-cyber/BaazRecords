---
/**
 * Lite YouTube facade: shows the thumbnail and a play button. The real YouTube
 * player (privacy-enhanced youtube-nocookie.com) loads only after a click.
 */
import Icon from './Icon.astro';
import YtThumb from './YtThumb.astro';
import type { Video } from '../lib/content';

interface Props {
  video: Video;
  eager?: boolean;
}
const { video: v, eager = false } = Astro.props;
---
<div class="yt" data-yt={v.youtubeId} data-yt-title={v.title}>
  <YtThumb id={v.youtubeId} alt={`Thumbnail for ${v.title}`} widths={[400, 640, 960, 1280]} sizes="(max-width: 900px) 92vw, 640px" eager={eager} />
  <button class="yt-play" type="button" data-magnetic="0.3" data-cursor="Play" aria-label={`Play video: ${v.title}`}>
    <span><Icon name="play" /></span>
  </button>
</div>
