---
/** Artist card with 3D tilt and a glowing border beam on hover. */
import ArtistArt from './ArtistArt.astro';
import Icon from './Icon.astro';
import type { Artist } from '../lib/content';

interface Props {
  artist: Artist;
  index?: number;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}
const { artist: a, index, headingLevel = 'h3', eager = false } = Astro.props;
const H = headingLevel;
---
<article class="beam tilt" data-tilt data-cursor="View">
  <a class="a-card" href={`/artists/${a.id}/`}>
    <div class="photo">
      <ArtistArt artist={a} eager={eager} />
    </div>
    <div class="body">
      <div>
        <p class="mono muted mb-2">{index !== undefined ? `${String(index + 1).padStart(2, '0')} // ` : ''}{a.genre}</p>
        <H>{a.name}</H>
      </div>
      <span class="go" aria-hidden="true"><Icon name="external" /></span>
    </div>
  </a>
</article>
