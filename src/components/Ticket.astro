---
import Icon from './Icon.astro';
import { site } from '../lib/site';
import { formatDoors, formatEventDate, formatPrice, type Event } from '../lib/content';

interface Props {
  event: Event;
  headingLevel?: 'h2' | 'h3';
}
const { event: e, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const ticketHref = e.ticketUrl || `mailto:${site.email}?subject=${encodeURIComponent(`Tickets for ${e.title}`)}`;
const external = Boolean(e.ticketUrl);
const meta = [
  { k: 'Date', v: formatEventDate(e.date) },
  { k: 'Doors', v: formatDoors(e.doors) },
  { k: 'Venue', v: [e.venue, e.city].filter(Boolean).join(', ') },
  { k: 'Price', v: formatPrice(e.price, e.currency) },
].filter((m) => m.v);
---
<article class="ticket beam" id={e.id} aria-label={`Concert ticket: ${e.title}`}>
  <div class="t-main">
    <p class="t-pre mono flex items-center gap-2"><span class="rec-dot" aria-hidden="true"></span>{e.presenter}</p>
    <H class="t-title">{e.title}</H>
    {e.lineup && <p class="t-lineup">{e.lineup}</p>}
    <dl class="t-meta">
      {meta.map((m) => <div><dt class="mono">{m.k}</dt><dd>{m.k === 'Date' ? <time datetime={e.date}>{m.v}</time> : m.v}</dd></div>)}
    </dl>
    {e.address && <p class="muted mb-5 text-sm">{e.address}</p>}
    <a class="btn" href={ticketHref} data-magnetic="0.35" {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
      <span class="btn-label">Get tickets <Icon name={external ? 'external' : 'mail'} /></span>
    </a>
  </div>
  <div class="t-stub" aria-hidden="true">
    <div class="admit">Admit<br />one</div>
    <div class="ga">{e.ticketLabel}</div>
    <div class="barcode"></div>
    {e.ticketNumber && <div class="mono">No. {e.ticketNumber}</div>}
  </div>
</article>
