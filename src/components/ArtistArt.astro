---
/** Artist photo (AVIF/WebP, black & white until hover) or, without a photo, a record in the artist's colour. */
import { Picture } from 'astro:assets';
import Vinyl from './Vinyl.astro';
import { artistPhoto } from '../lib/media';
import { initials, type Artist } from '../lib/content';

interface Props {
  artist: Artist;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
}
const { artist, widths = [320, 480, 640, 960], sizes = '(max-width: 600px) 92vw, 340px', eager = false } = Astro.props;
const photo = artistPhoto(artist.photo, artist.name);
---
{photo ? (
  <Picture
    src={photo}
    alt={artist.photoAlt || `Photo of ${artist.name}`}
    formats={['avif', 'webp']}
    widths={widths}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
  />
) : (
  <div class="ph-art" style={`--c:${artist.color}`} role="img" aria-label={`${artist.name} artwork`}>
    <Vinyl color={artist.color} label={initials(artist.name)} />
    <span class="init mono muted">No photo yet</span>
  </div>
)}
