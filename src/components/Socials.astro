---
import Icon from './Icon.astro';
import { filledLinks, linkNames } from '../lib/content';

interface Props {
  links: Record<string, string | undefined>;
  label?: string;
}
const { links, label = 'Social links' } = Astro.props;
const items = filledLinks(links);
---
{items.length > 0 && (
  <ul class="socials" aria-label={label}>
    {items.map(([key, url]) => (
      <li>
        <a href={url} target="_blank" rel="noopener noreferrer me" aria-label={`${linkNames[key] ?? key} (opens in a new tab)`} data-magnetic="0.3">
          <Icon name={key} />
        </a>
      </li>
    ))}
  </ul>
)}
