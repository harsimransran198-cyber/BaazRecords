---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import { site } from '../lib/site';

const endpoint = site.demo.formEndpoint;
---
<Base title="Send a demo" description={`Send your music to ${site.name}. Recorded on a phone or in a studio, we listen to everything that comes in.`}>
  <section class="section page-top">
    <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'Send a demo', path: '/demo/' }]} />
    <div class="grid gap-10 lg:grid-cols-[minmax(0,.8fr)_minmax(0,1.2fr)] lg:gap-20">
      <div>
        <h1 class="sec-title">Send us your demo</h1>
        <div class="prose">
          <p>{site.demo.intro}</p>
          <p>Please send a link (SoundCloud, YouTube, Google Drive, Dropbox or similar) rather than attachments. We reply within two working days.</p>
        </div>
      </div>

      <form
        class="form panel"
        id="demoForm"
        action={endpoint || `mailto:${site.email}?subject=${encodeURIComponent('Demo submission')}`}
        method="post"
        enctype={endpoint ? undefined : 'text/plain'}
        data-mode={endpoint ? 'endpoint' : 'mailto'}
        data-email={site.email}
      >
        <div class="row">
          <div class="field">
            <label for="d-name">Your name</label>
            <input id="d-name" name="name" type="text" autocomplete="name" required maxlength="120" />
          </div>
          <div class="field">
            <label for="d-email">Email</label>
            <input id="d-email" name="email" type="email" autocomplete="email" required maxlength="200" />
          </div>
        </div>
        <div class="row">
          <div class="field">
            <label for="d-artist">Artist or band name</label>
            <input id="d-artist" name="artist" type="text" required maxlength="120" />
          </div>
          <div class="field">
            <label for="d-city">City</label>
            <input id="d-city" name="city" type="text" autocomplete="address-level2" maxlength="120" />
          </div>
        </div>
        <div class="field">
          <label for="d-link">Link to your music</label>
          <input id="d-link" name="link" type="url" inputmode="url" placeholder="https://" required maxlength="500" pattern="https://.+" />
          <span class="hint">Must start with https://</span>
        </div>
        <div class="field">
          <label for="d-msg">Tell us about the music</label>
          <textarea id="d-msg" name="message" maxlength="3000" rows="6"></textarea>
        </div>
        {/* Spam trap: people never see or fill this. */}
        <div class="sr-only" aria-hidden="true">
          <label for="d-company">Leave this empty</label>
          <input id="d-company" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <div class="flex flex-wrap items-center gap-4">
          <button class="btn" type="submit">Send demo <Icon name="arrow" /></button>
          <p class="form-status" role="status" aria-live="polite"></p>
        </div>
        {!endpoint && <p class="hint muted text-sm">This opens your email app with everything filled in. Or write to <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>.</p>}
      </form>
    </div>
  </section>

  <script>
    import { initDemoForm } from '../scripts/demo';
    document.addEventListener('astro:page-load', initDemoForm);
  </script>
</Base>
