---
import Base from '../layouts/Base.astro';
import Sleeve from '../components/Sleeve.astro';
import RingButton from '../components/RingButton.astro';
import Marquee from '../components/Marquee.astro';
import ReleaseCard from '../components/ReleaseCard.astro';
import ArtistCard from '../components/ArtistCard.astro';
import Ticket from '../components/Ticket.astro';
import YouTube from '../components/YouTube.astro';
import Icon from '../components/Icon.astro';
import { site } from '../lib/site';
import { artistsOf, formatEventDate, getArtists, getRelease, getReleases, getUpcomingEvents, getVideos, isPlayable } from '../lib/content';
import { itemList, musicAlbum, musicEvent, videoObject } from '../lib/schema';

const releases = getReleases().filter((r) => r.showInCatalogue);
const artists = getArtists();
const events = getUpcomingEvents();
const videos = getVideos().slice(0, 2);
const hero = getRelease(site.hero.release)!;
const heroTrack = hero.tracks[site.hero.trackNumber - 1] ?? hero.tracks[0];

const onAir = events.length
  ? events.flatMap((e) => [`On air: ${e.title}`, formatEventDate(e.date), e.venue])
  : ['Studio open', 'Demos welcome', site.email];

const schema = [
  musicAlbum(hero),
  itemList('The vault', releases.map((r) => r.url)),
  itemList(`${site.name} artists`, artists.map((a) => `/artists/${a.id}/`)),
  ...events.map((e) => musicEvent(e, artistsOf(e.artists))),
  ...videos.map(videoObject),
];
---
<Base schema={schema}>
  <!-- ============ HERO ============ -->
  <section class="hero" data-hero aria-labelledby="hero-title">
    <canvas class="visualizer" data-visualizer aria-hidden="true"></canvas>
    <div class="wrap hero-inner">
      <p class="mono flex items-center gap-3 text-muted" data-hero-fade style="--fi:0">
        <span class="rec-dot" aria-hidden="true"></span>
        <span>Rec // {site.hero.eyebrow}</span>
      </p>
      <h1 class="display hero-title mt-6" id="hero-title" aria-label={`${site.name}: ${site.tagline}`}>
        <span class="split-line" aria-hidden="true"><span class="l1 block">{[...'Baaz'].map((c, i) => <span class="char" style={`--i:${i}`}>{c}</span>)}</span></span>
        <span class="split-line" aria-hidden="true"><span class="l2 block">{[...'Records'].map((c, i) => <span class="char" style={`--i:${i + 3}`}>{c}</span>)}</span></span>
      </h1>

      <div class="hero-show" data-hero-fade style="--fi:2">
        <Sleeve release={hero} eager />
        <div class="caption mono">
          <span>Featured // {hero.catNo}</span>
          <b>{hero.title} — {hero.byline}</b>
        </div>
      </div>

      <div class="hero-copy" data-hero-fade style="--fi:3">
        <RingButton
          href={hero.url}
          label={heroTrack && isPlayable(heroTrack) ? `Play ${heroTrack.title} by ${hero.byline}` : `Listen to ${hero.title}`}
          track={heroTrack}
          release={hero}
          youtubeId={hero.youtubeId || undefined}
        />
        <div>
          <p class="text-ink text-lg font-semibold">{site.tagline}.</p>
          <p class="mt-2">{site.hero.text}</p>
        </div>
      </div>
    </div>
    <div class="hero-scroll mono" aria-hidden="true">Scroll<i></i></div>
  </section>

  <Marquee items={site.marquee} />

  <!-- ============ DISCOGRAPHY VAULT (horizontal) ============ -->
  <section class="vault section" data-vault aria-labelledby="vault-title">
    <div class="wrap vault-head mb-12">
      <div>
        <p class="sec-index mono mb-5">( 01 ) Discography vault</p>
        <h2 class="sec-title" id="vault-title" data-reveal>The vault</h2>
      </div>
      <p class="muted max-w-[38ch]">Every record we have pressed, newest first. Hover a sleeve to pull the vinyl out.</p>
    </div>
    <div data-vault-pin>
      <div class="vault-track" data-vault-track>
        {releases.map((r, i) => <ReleaseCard release={r} eager={i < 2} />)}
        <a class="vault-end" href="/releases/" data-cursor="Open">
          <span class="mono crimson">{releases.length} records</span>
          <span class="display">Full<br />catalogue</span>
          <span class="link-arrow">Open the vault <Icon name="external" /></span>
        </a>
      </div>
      <div class="wrap"><div class="vault-progress" aria-hidden="true"><i data-vault-bar></i></div></div>
    </div>
  </section>

  <!-- ============ ROSTER ============ -->
  <section class="section wrap" aria-labelledby="roster-title">
    <div class="flex flex-wrap items-end justify-between gap-6 mb-12">
      <div>
        <p class="sec-index mono mb-5">( 02 ) Roster</p>
        <h2 class="sec-title" id="roster-title" data-reveal>The artists</h2>
      </div>
      <a class="link-arrow" href="/artists/">All artists <Icon name="external" /></a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {artists.map((a, i) => <ArtistCard artist={a} index={i} />)}
    </div>
  </section>

  <Marquee items={onAir} variant="crimson" reverse />

  <!-- ============ LIVE ============ -->
  {events.length > 0 && (
    <section class="section wrap" id="live" aria-labelledby="live-title">
      <p class="sec-index mono mb-5">( 03 ) Live</p>
      <h2 class="sec-title mb-6" id="live-title" data-reveal>On stage</h2>
      {events[0]!.summary && <p class="muted max-w-[52ch] mb-10 text-lg">{events[0]!.summary}</p>}
      <Ticket event={events[0]!} />
      {events.length > 1 && <p class="mt-10"><a class="link-arrow" href="/live/">All {events.length} shows <Icon name="external" /></a></p>}
    </section>
  )}

  <!-- ============ VISUALS ============ -->
  {videos.length > 0 && (
    <section class="section wrap" aria-labelledby="visuals-title">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-12">
        <div>
          <p class="sec-index mono mb-5">( 04 ) Visuals</p>
          <h2 class="sec-title" id="visuals-title" data-reveal>On film</h2>
        </div>
        <a class="link-arrow" href="/visuals/">All videos <Icon name="external" /></a>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        {videos.map((v) => (
          <figure>
            <YouTube video={v} />
            <figcaption class="mt-4 flex justify-between gap-4"><span class="font-semibold">{v.title}</span><span class="mono muted">{v.duration}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <!-- ============ STUDIO ============ -->
  <section class="section wrap" id="studio" aria-labelledby="studio-title">
    <p class="sec-index mono mb-5">( {videos.length ? '05' : '04'} ) The studio</p>
    <h2 class="sr-only" id="studio-title">The studio</h2>
    <div class="grid gap-12 lg:grid-cols-[1.3fr_1fr] lg:gap-24 items-end">
      <blockquote class="font-display font-bold uppercase tracking-tight leading-[.95] text-[clamp(1.9rem,4.4vw,4rem)]" data-reveal-lines>
        “{site.studio.quote}”
      </blockquote>
      <div class="beam p-8 grid gap-5">
        <div class="flex items-center justify-between gap-4">
          <span class="mono crimson flex items-center gap-2"><span class="rec-dot" aria-hidden="true"></span>Recording</span>
          <div class="vu" aria-hidden="true">{Array.from({ length: 14 }, () => <i></i>)}</div>
        </div>
        {site.studio.paragraphs.map((p) => <p class="muted leading-relaxed">{p}</p>)}
        <div>
          <a href={`mailto:${site.email}?subject=${encodeURIComponent('Studio booking')}`} class="btn" data-magnetic="0.35">
            <span class="btn-label">{site.studio.button} <Icon name="arrow" /></span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/hero';
    import '../scripts/scroll-fx';
  </script>
</Base>
