---
import Base from '../../layouts/Base.astro';
import ArtistArt from '../../components/ArtistArt.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getArtists } from '../../lib/content';
import { itemList } from '../../lib/schema';
import { site } from '../../lib/site';

const artists = await getArtists();
---
<Base
  title="Artists"
  description={`The ${site.name} roster: ${artists.map((a) => a.name).join(', ')}. Punjabi folk, sufi and dub, recorded live.`}
  schema={[itemList(`${site.name} artists`, artists.map((a) => `/artists/${a.id}/`))]}
>
  <section class="section page-top">
    <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'Artists', path: '/artists/' }]} />
    <h1 class="sec-title">The roster</h1>
    <ul class="artist-grid">
      {artists.map((a, i) => (
        <li>
          <a class="artist-card panel" href={`/artists/${a.id}/`}>
            <div class="photo">
              <ArtistArt artist={a} eager={i < 2} sizes="(max-width: 600px) 100vw, (max-width: 1100px) 50vw, 340px" />
            </div>
            <div class="body">
              <h2>{a.name}</h2>
              {a.genre && <span class="genre">{a.genre}</span>}
              {a.shortBio && <p>{a.shortBio}</p>}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
