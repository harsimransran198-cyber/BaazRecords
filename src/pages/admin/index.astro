---
/**
 * Admin panel at /admin/ (Sveltia CMS). Only people who can write to the
 * GitHub repo can sign in and save. Not linked from the site and hidden from search.
 */
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="same-origin" />
    <title>Baaz Records admin</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <script>
      import CMS from '@sveltia/cms';
      import { config } from '../../lib/cms-config';
      CMS.init({ config });
    </script>
  </body>
</html>
